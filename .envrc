# Auto-generated by naicibox — do not commit
NAICIBOX_CONFIG="$PROJECTS_HOME/.naicibox/$(basename "$PWD")"

export HISTFILE="$PWD/.bash_history"
export STARSHIP_CONFIG="$NAICIBOX_CONFIG/starship.toml"

# Auto-start tmux session only when explicitly opted in.
# Set NAICIBOX_AUTOSTART=1 (e.g. in ~/.bashrc) to enable; off by default
# so scripts and non-interactive `cd` don't spawn tmux.
if [ "${NAICIBOX_AUTOSTART:-0}" = "1" ] && [ -z "${TMUX:-}" ]; then
  project-start.sh "$(basename "$PWD")"
fi
